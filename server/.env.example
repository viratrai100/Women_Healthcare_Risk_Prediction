# ──────────────────────────────────────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ai_womens_healthcare

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── AI Provider Selection ─────────────────────────────────────────────────────
# Which provider to use for risk predictions.
# Valid values: gemini | grok | ml
# Default: ml (local rule-based engine — no external key required)
AI_PROVIDER=ml

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# ── xAI Grok ─────────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=grok
# Get your key at: https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_API_URL=https://api.x.ai/v1

# ── Local ML Engine ───────────────────────────────────────────────────────────
# Used when AI_PROVIDER=ml
# ML_MODE options:
#   rule_based — deterministic rule engine (default, zero dependencies)
#   onnx       — ONNX Runtime with a local .onnx model file
#   python     — calls a local Python FastAPI / Flask microservice
ML_MODE=rule_based
ML_MODEL_VERSION=rule-engine-v1.0
ML_ONNX_MODEL_PATH=
ML_PYTHON_URL=http://localhost:8000
